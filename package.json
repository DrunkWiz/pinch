{
  "name": "pinch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Pinch interviews your grandparent while they cook, so 'a pinch' gets pinned down while their hands are still in the pot.",
  "scripts": {
    "dev": "concurrently -n web,api -c magenta,cyan \"vite\" \"node --watch-path=server --env-file-if-exists=.env server/index.js\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
